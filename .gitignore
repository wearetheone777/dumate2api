# --- DuMate ecosystem runtime assets (56M / 22M, shipped by the client) ---
skills/
plugins/

# --- admin runtime state ---
data/

# --- web build artifacts ---
web/dist/

# --- runtime / generated ---
log/
desktop-main/*.db
desktop-main/*.db-shm
desktop-main/*.db-wal
scheduler/executions.jsonl
*.log
*.err

# --- historical debug artifacts ---
test/_archive/

# --- disabled / temp copies ---
.plugins_disabled/
.plugins_tmp/
.skills_disabled/
.skills_tmp/

# --- deps ---
# 包管理器统一 pnpm（根 + web），pnpm-lock.yaml 入库。
# npm 的 package-lock.json 一律忽略：两套锁文件并存会让「装到哪个版本」
# 变成取决于谁最后跑过 install。
node_modules/
package-lock.json
web/package-lock.json
.pnpm-store/

# --- OS ---
Thumbs.db
.DS_Store
# --- admin login helper ---
data/browser-profile/

# --- 本地调试产物（不属于项目资产）---
# .webprobe/ 是抓下来的第三方前端 bundle（7MB+），.p2.txt 是误存进 txt 的
# 二进制，.tmptest*/ 是临时数据目录，.runlogs/ 是本地启动日志。
.webprobe/
.tmptest*/
.p2.txt
.runlogs/
# CLAUDE.md 重构时的本地备份，不入库（内容以仓库里的 CLAUDE.md 为准）
CLAUDE.md.bak-*
# .hy4out/ 是 hy4 批量扫描任务的产出报告（p*_*.md），本地生成物
.hy4out/

# --- 调度器运行时状态（executions.jsonl 已单独忽略，这里补上其余）---
scheduler/*.json

# --- skills/plugins 生态的生成物（那两个目录本身已忽略，这里补上同源文件）---
skill-categories.json

# --- 本地会话产物（Claude Code 运行时状态，不属项目资产）---
.claude/

# --- Archify 生成的图（本地产物，单文件 HTML，不属项目资产）---
.archify/
